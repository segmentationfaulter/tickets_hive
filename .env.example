# TicketHive Environment Variables Template
# Copy this file to .env.local or .env.docker and fill in your values

# ==============================================================================
# SERVER SERVICE CONFIGURATION
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
JWT_EXPIRATION=24H

# Database Connection Configuration (for server connecting to database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tickets_hive
POSTGRES_USER=postgres

# Security - Use secure random values in production
# For Docker development: Use *_FILE variants (POSTGRES_PASSWORD_FILE, JWT_SECRET_FILE, REDIS_PASSWORD_FILE)
# For local development: Use direct values (POSTGRES_PASSWORD, JWT_SECRET, REDIS_PASSWORD)
POSTGRES_PASSWORD=your_secure_postgres_password_here
JWT_SECRET=your_secure_jwt_secret_here

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

# Redis Connection Configuration (for BullMQ queue)
# REDIS_PASSWORD is REQUIRED for security (protects job queue integrity)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# Worker Configuration (Level 3 MVP)
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_MS=100

# ==============================================================================
# DATABASE SERVICE CONFIGURATION (Docker only)
# ==============================================================================

# Database Container Configuration (for PostgreSQL initialization in Docker)
# These are only needed when running with Docker Compose
# POSTGRES_DB=tickets_hive
# POSTGRES_PASSWORD_FILE=/run/secrets/db-password

# ==============================================================================
# QUICK SETUP INSTRUCTIONS:
# ==============================================================================
#
# Option 1: Automated Setup (Recommended)
#   Run: npm run setup
#   This automatically creates secrets/ directory with secure values
#
# Option 2: Manual Setup
#   1. Copy this file to .env.local for local development
#   2. Update POSTGRES_PASSWORD, JWT_SECRET, and REDIS_PASSWORD with secure random values
#   3. For Docker development, also copy to .env.docker and use *_FILE variants
#
# Option 3: Docker Secrets (Production-like)
#   1. Run: npm run setup (creates secrets/ directory)
#   2. Use POSTGRES_PASSWORD_FILE, JWT_SECRET_FILE, and REDIS_PASSWORD_FILE in your environment
# ==============================================================================
