# TicketHive Environment Variables Template
# Copy this file to .env.local, .env.docker, or .env.test and fill in your values

# Server Configuration
PORT=3000
JWT_EXPIRATION=24H
NODE_ENV=development

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tickets_hive
POSTGRES_USER=postgres

# Security - Use secure random values in production
# For Docker development: Use POSTGRES_PASSWORD_FILE and JWT_SECRET_FILE
# For local development: Use direct POSTGRES_PASSWORD and JWT_SECRET values
POSTGRES_PASSWORD=your_secure_postgres_password_here
JWT_SECRET=your_secure_jwt_secret_here

# Docker Secrets (alternative to direct values)
# POSTGRES_PASSWORD_FILE=/run/secrets/db-password
# JWT_SECRET_FILE=/run/secrets/jwt-secret

# Development values (used by setup script)
# DEV_POSTGRES_PASSWORD=dev_postgres_password_for_local_development
# DEV_JWT_SECRET=dev_jwt_secret_for_local_development

# ============================================================================
# QUICK SETUP INSTRUCTIONS:
#
# Option 1: Automated Setup (Recommended)
#   Run: npm run setup
#   This automatically creates secrets/ directory with secure values
#
# Option 2: Manual Setup
#   1. Copy this file to .env.local for local development
#   2. Update POSTGRES_PASSWORD and JWT_SECRET with secure random values
#   3. For Docker development, also copy to .env.docker and use *_FILE variants
#
# Option 3: Docker Secrets (Production-like)
#   1. Run: npm run setup (creates secrets/ directory)
#   2. Use POSTGRES_PASSWORD_FILE and JWT_SECRET_FILE in your environment
# ============================================================================
